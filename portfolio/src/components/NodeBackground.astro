<canvas id="node-field" aria-hidden="true"></canvas>

<script>
  const LINK = 160;
  const MAX_PULSES = 4;

  const canvas = document.getElementById('node-field');
  const ctx = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;

  if (canvas && ctx) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let palette = readPalette();
    let nodes = [];
    let pulses = [];
    let width = 0;
    let height = 0;
    let mobile = false;
    let raf = 0;
    let last = 0;
    let nextPulseAt = 0;

    function readPalette() {
      const s = getComputedStyle(document.documentElement);
      return { node: s.getPropertyValue('--node').trim(), accent: s.getPropertyValue('--accent').trim() };
    }

    const dist = (p, q) => Math.hypot(p.x - q.x, p.y - q.y);

    function seed() {
      const count = width < 768 ? 18 : 40;
      nodes = Array.from({ length: count }, () => {
        const speed = 3 + Math.random() * 5; // px per second
        const angle = Math.random() * Math.PI * 2;
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
        };
      });
      pulses = [];
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const isMobile = width < 768;
      if (nodes.length === 0 || isMobile !== mobile) {
        mobile = isMobile;
        seed();
      }
      if (reduce.matches || raf === 0) draw();
    }

    function spawnPulse() {
      if (pulses.length >= MAX_PULSES) return;
      const i = Math.floor(Math.random() * nodes.length);
      const near = nodes.map((_, k) => k).filter((k) => k !== i && dist(nodes[i], nodes[k]) < LINK);
      if (near.length) {
        pulses.push({ a: i, b: near[Math.floor(Math.random() * near.length)], t: 0 });
      }
    }

    function step(dt) {
      for (const n of nodes) {
        n.x += n.vx * dt;
        n.y += n.vy * dt;
        if (n.x < -20) n.x = width + 20;
        else if (n.x > width + 20) n.x = -20;
        if (n.y < -20) n.y = height + 20;
        else if (n.y > height + 20) n.y = -20;
      }
      for (const p of pulses) p.t += dt / 1.8;
      pulses = pulses.filter((p) => p.t < 1 && dist(nodes[p.a], nodes[p.b]) < LINK);
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);
      ctx.lineWidth = 1;
      ctx.strokeStyle = palette.node;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const d = dist(nodes[i], nodes[j]);
          if (d < LINK) {
            ctx.globalAlpha = 0.28 * (1 - d / LINK);
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }
      ctx.globalAlpha = 0.8;
      ctx.fillStyle = palette.node;
      for (const n of nodes) {
        ctx.beginPath();
        ctx.arc(n.x, n.y, 1.6, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 0.9;
      ctx.fillStyle = palette.accent;
      for (const p of pulses) {
        const a = nodes[p.a];
        const b = nodes[p.b];
        ctx.beginPath();
        ctx.arc(a.x + (b.x - a.x) * p.t, a.y + (b.y - a.y) * p.t, 2.2, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    function frame(now) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      if (now > nextPulseAt) {
        spawnPulse();
        nextPulseAt = now + 1500 + Math.random() * 2500;
      }
      step(dt);
      draw();
      raf = requestAnimationFrame(frame);
    }

    function run() {
      if (raf || reduce.matches || document.hidden) return;
      last = performance.now();
      nextPulseAt = last + 1000;
      raf = requestAnimationFrame(frame);
    }

    function halt() {
      cancelAnimationFrame(raf);
      raf = 0;
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 200);
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? halt() : run()));
    reduce.addEventListener('change', () => {
      halt();
      if (reduce.matches) draw();
      else run();
    });
    window.addEventListener('themechange', () => {
      palette = readPalette();
      if (reduce.matches || raf === 0) draw();
    });

    resize();
    run();
  }
</script>
