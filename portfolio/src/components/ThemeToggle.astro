<button id="theme-toggle" class="icon-button" type="button" aria-label="Switch to light mode" hidden>
  <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
  <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" /></svg>
</button>
<script>
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;
  if (toggle) {
    const updateLabel = () => toggle.setAttribute('aria-label', root.classList.contains('light') ? 'Switch to dark mode' : 'Switch to light mode');
    updateLabel();
    toggle.addEventListener('click', () => {
      const theme = root.classList.contains('light') ? 'dark' : 'light';
      root.classList.remove('dark', 'light');
      root.classList.add(theme);
      try { localStorage.setItem('theme', theme); } catch {}
      updateLabel();
      window.dispatchEvent(new Event('themechange'));
    });
    toggle.hidden = false;
  }
</script>
