---
import Card from './Card.astro';
import { publications } from '../data/publications.js';
---
<section id="publications" class="reveal" aria-labelledby="publications-heading">
  <div class="section-heading"><span class="section-number" aria-hidden="true">02</span><h2 id="publications-heading">Publications</h2></div>
  <ul class="publication-list">
    {publications.map(publication => <li><Card interactive>
      <h3 class="publication-title">{publication.title}</h3>
      <p class="venue">{publication.venue}</p>
      <div class="publication-meta"><span class="tag">{publication.status}</span>
        {publication.link && <a class="text-link" href={publication.link} target="_blank" rel="noopener noreferrer">View paper</a>}
      </div>
    </Card></li>)}
  </ul>
</section>
