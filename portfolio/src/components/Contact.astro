---
import { profile } from '../data/profile.js';
const paths = [
  'M3 5h18v14H3z M3 5l9 7 9-7',
  'M5 10v10 M5 5v.01 M10 20V10h4v2c1-3 6-3 6 2v6 M14 12v8',
  'M2 9l10-6 10 6-10 6-10-6 M6 12v6c4 3 8 3 12 0v-6 M22 9v9',
];
---
<section id="contact" class="reveal" aria-labelledby="contact-heading">
  <div class="section-heading"><span class="section-number" aria-hidden="true">06</span><h2 id="contact-heading">Contact</h2></div>
  <ul class="contact-links">
    {profile.contact.map((contact, i) => <li><a class="text-link" href={contact.href} target={i === 0 ? undefined : '_blank'} rel={i === 0 ? undefined : 'noopener noreferrer'}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[i]} /></svg>
      {contact.label}
    </a></li>)}
  </ul>
</section>
